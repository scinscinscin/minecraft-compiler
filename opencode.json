{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["llama"],
  "provider": {
    "llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": { "baseURL": "http://192.168.0.78:8080/v1" },
      "models": {
        "your-model-id": {
          "id": "unsloth/Qwen3.6-35B-A3B-MTP-GGUF:IQ4_XS",
          "name": "unsloth/Qwen3.6-35B-A3B-MTP-GGUF:IQ4_XS",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    }
  },

  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "disabled": false,
        "codemode": false
      }
    }
  }
}
